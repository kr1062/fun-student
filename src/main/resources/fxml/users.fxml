<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.student.ui.controller.UserManagementController">
    <top>
        <HBox spacing="10.0" style="-fx-padding: 10;">
            <Button onAction="#handleAddUser" text="➕ Создать пользователя" styleClass="button-success" />
            <Button onAction="#loadUsers" text="🔄 Обновить" />
        </HBox>
    </top>
    <center>
        <TableView fx:id="userTable">
            <columns>
                <TableColumn fx:id="userIdCol" text="ID" prefWidth="75.0" />
                <TableColumn fx:id="userEmailCol" text="Email" prefWidth="250.0" />
                <TableColumn fx:id="userRolesCol" text="Роли" prefWidth="200.0" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="0.0" />
            </BorderPane.margin>
        </TableView>
    </center>
</BorderPane>